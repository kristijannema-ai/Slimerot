; Slimerot — offline portrait Android foundation.
config_version=5

[application]
config/name="Slimerot"
run/main_scene="res://scenes/Slimerot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="Slimerot"
config/icon="res://assets/Slimerot.svg"

[autoload]
GameState="*res://scripts/managers/SlimerotGameState.gd"
SlimeDatabase="*res://scripts/managers/SlimerotSlimeDatabase.gd"
SkillTreeManager="*res://scripts/managers/SlimerotSkillTreeManager.gd"
InventoryManager="*res://scripts/managers/SlimerotInventoryManager.gd"
WorldManager="*res://scripts/managers/SlimerotWorldManager.gd"
CombatManager="*res://scripts/managers/SlimerotCombatManager.gd"
RollManager="*res://scripts/managers/SlimerotRollManager.gd"
SaveManager="*res://scripts/managers/SlimerotSaveManager.gd"
SlimerotSound="*res://scripts/presentation/SlimerotAudio.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.043, 0.067, 0.09, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true
